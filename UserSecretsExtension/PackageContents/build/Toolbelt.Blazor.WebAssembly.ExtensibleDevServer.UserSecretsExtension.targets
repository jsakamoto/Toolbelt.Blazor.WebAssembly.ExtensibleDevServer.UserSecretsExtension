<Project>

  <Target Name="BzExDevSvr_UserSecrets_PrepareResponseFile" BeforeTargets="BzExDevSvr_GenerateResponseFile">
    <ItemGroup>
      <BzExDevSvrAssembly Include="Toolbelt.Blazor.WebAssembly.ExtensibleDevServer.UserSecretsExtension" />
      <BzExDevSvrDeps Include="$(MSBuildThisFileDirectory)../tools/net10.0/Toolbelt.Blazor.WebAssembly.ExtensibleDevServer.UserSecretsExtension.deps.json" />
      <BzExDevSvrEnvValue Include="DOTNET_USER_SECRETS_ID=$(UserSecretsId)" />
    </ItemGroup>
  </Target>

</Project>